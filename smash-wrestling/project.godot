; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Smash Wrestling - Claude Benchmark"
config/description="Super Smash Bros. 64 fighters in WWE SmackDown vs. Raw 2011-style wrestling (research build)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Controls="*res://scripts/core/controls.gd"
MotionDB="*res://scripts/core/motion_db.gd"
Game="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
