## Presentation mapping "SSB64 fighter state -> SmackDown vs. Raw 2011 clip" for the SvR animation
## mode. Two steps:
##   1. role_for(fkind, status_id): the SSB64 status (by its decomp enum name, nFT<Who>Status<Name>)
##      becomes a presentation role such as "jab1", "fsmash", "special_n", "idle", "hit_n", "thrown".
##   2. spec_for(slug, role): data/svr_anim_map.json (generated by tools/svr_anim/build_anim_map.py
##      from the recovered SvR movesets + motion catalogue) gives the clip for that wrestler and role:
##      {clip, victim_clip, timing, in, out, impact, rate, root, fade, move, source}. An empty
##      result means no recovered SvR clip covers the role; the renderer then shows the SSB64 motion
##      (retargeted) and labels it as a fallback.
## Gameplay never reads any of this.
extends RefCounted

const RU = preload("res://scripts/render/RenderUtil.gd")
const MAP_PATH := "data/svr_anim_map.json"
const FT_NAMES := ["Mario", "Fox", "Donkey", "Samus", "Luigi", "Link", "Yoshi", "Captain", "Kirby", "Pikachu", "Purin", "Ness"]

## status-name suffix prefix -> role (first match wins; order matters). A third element limits the rule
## to one fighter's own statuses. A role written "=role" continues the clip of the previous status when
## that status had role "role" (one SSB64 move made of several statuses), else it acts as "role".
const ROLE_RULES := [
	# Donkey Kong's cargo carry (walks / jumps with the opponent on his shoulders) and its carried victim
	["ThrowFWait", "carry", "Donkey"], ["ThrowFWalk", "carry", "Donkey"], ["ThrowFTurn", "carry", "Donkey"],
	["ThrowFKneeBend", "carry", "Donkey"], ["ThrowFFall", "carry", "Donkey"], ["ThrowFLanding", "carry", "Donkey"],
	["ThrowFDamage", "carry", "Donkey"], ["ThrowFF", "throw_f", "Donkey"], ["ThrowAirFF", "throw_f", "Donkey"],
	["Shouldered", "carried"],
	# Kirby's forward throw is three statuses (leap, fall, piledriver landing)
	["ThrowFFall", "=throw_f", "Kirby"], ["ThrowFLanding", "=throw_f", "Kirby"],
	["Attack100", "jab_rapid"], ["Attack11", "jab1"], ["Attack12", "jab2"], ["Attack13", "jab3"],
	["AttackDash", "dash_attack"], ["AttackS3", "ftilt"], ["AttackHi3", "utilt"], ["AttackLw3", "dtilt"],
	["AttackS4", "fsmash"], ["AttackHi4", "usmash"], ["AttackLw4", "dsmash"],
	["AttackAirN", "nair"], ["AttackAirF", "fair"], ["AttackAirB", "bair"], ["AttackAirHi", "uair"],
	["AttackAirLw", "dair"], ["LandingAir", "land"],
	["SpecialAirN", "special_n"], ["SpecialN", "special_n"], ["SpecialAirHi", "special_hi"], ["SpecialHi", "special_hi"],
	["SpecialAirLw", "special_lw"], ["SpecialLw", "special_lw"], ["SpecialAirS", "special_s"], ["SpecialS", "special_s"],
	["Appeal", "taunt"],
	["CatchPull", "grab"], ["CatchWait", "grab_hold"], ["Catch", "grab"],
	["ThrowF", "throw_f"], ["ThrowB", "throw_b"],
	["CapturePulled", "captured"], ["CaptureWait", "captured"], ["Capture", "captured"],
	["Thrown", "thrown"],
	["LightThrow", "item_throw"], ["HeavyThrow", "item_throw"], ["LightGet", "pickup"], ["HeavyGet", "pickup"],
	["HeavyWalk", "walk"], ["HeavyWait", "idle"],
	["SwordSwing", "item_swing"], ["BatSwing", "item_swing"], ["HarisenSwing", "item_swing"], ["StarRodSwing", "item_swing"],
	["LGunShoot", "item_shoot"], ["FireFlowerShoot", "item_shoot"], ["Hammer", "hammer"],
	["DownAttack", "getup_attack"], ["CliffAttack", "ledge_attack"], ["CliffEscape", "ledge_roll"],
	["CliffClimb", "ledge_climb"], ["CliffQuick", "ledge_climb"], ["CliffSlow", "ledge_climb"],
	["CliffCatch", "ledge_hang"], ["CliffWait", "ledge_hang"],
	["DamageFlyRoll", "tumble"], ["DamageFly", "tumble"], ["DamageFall", "tumble"], ["WallDamage", "tumble"],
	["DamageHi", "hit_hi"], ["DamageN", "hit_n"], ["DamageLw", "hit_lw"], ["DamageAir", "hit_air"], ["DamageE", "hit_n"],
	["DownBounce", "knockdown"], ["DownWait", "downed"], ["DownStand", "getup"], ["DownForward", "getup_roll"],
	["DownBack", "getup_roll"], ["PassiveStand", "tech_roll"], ["Passive", "tech"],
	["ShieldBreakFly", "tumble"], ["ShieldBreakFall", "tumble"], ["ShieldBreakDown", "knockdown"],
	["ShieldBreakStand", "getup"], ["FuraFura", "dizzy"], ["FuraSleep", "sleep"],
	["GuardOn", "block"], ["GuardOff", "block"], ["GuardSetOff", "block"], ["Guard", "block"],
	["EscapeF", "roll"], ["EscapeB", "roll"], ["Rebound", "rebound"],
	["KneeBend", "jump_squat"], ["GuardKneeBend", "jump_squat"], ["JumpAerial", "jump_air"], ["Jump", "jump"],
	["FallSpecial", "fall"], ["FallAerial", "fall"], ["Fall", "fall"], ["Pass", "fall"], ["StopCeil", "fall"],
	["LandingFallSpecial", "land"], ["Landing", "land"],
	["SquatWait", "crouch"], ["SquatRv", "crouch_end"], ["Squat", "crouch_start"],
	["OttottoWait", "teeter"], ["Ottotto", "teeter"],
	["WalkEnd", "idle"], ["Walk", "walk"], ["Dash", "run_start"], ["RunBrake", "run_brake"], ["TurnRun", "turn"],
	["Run", "run"], ["Turn", "turn"], ["Wait", "idle"],
	["Entry", "entry"], ["Appear", "entry"], ["Rebirth", "respawn"], ["Dead", "ko"], ["Sleep", "ko"],
	["Twister", "tumble"], ["Dokan", "idle"],
]

## Default playback per role when the map entry does not override it.
##   loop: cycles at the clip's own rate; fit: SSB motion progress -> clip [in, out];
##   hit: like fit but the clip's impact frame lands on the SSB motion's first active hitbox frame;
##   hold: plays once at the clip's rate and holds the last frame.
const ROLE_TIMING := {
	"idle": "loop", "walk": "loop", "run": "loop", "crouch": "loop", "fall": "loop", "teeter": "loop",
	"ledge_hang": "loop", "block": "loop", "dizzy": "loop", "sleep": "loop", "grab_hold": "loop",
	"captured": "loop", "downed": "loop", "hammer": "loop", "tumble": "fit", "respawn": "loop",
	"jab_rapid": "loop",
}
const ATTACK_ROLES := ["jab1", "jab2", "jab3", "dash_attack", "ftilt", "utilt", "dtilt", "fsmash", "usmash",
	"dsmash", "nair", "fair", "bair", "uair", "dair", "special_n", "special_hi", "special_lw", "special_s",
	"getup_attack", "ledge_attack", "item_swing", "throw_f", "throw_b", "grab"]

static var _data = null
static var _roles: Dictionary = {}       # fkind -> {status_id: [role, status_name]}

static func data() -> Dictionary:
	if _data == null:
		_data = {}
		var p := RU.asset_path(MAP_PATH)
		if FileAccess.file_exists(p):
			var d = JSON.parse_string(FileAccess.get_file_as_string(p))
			if d is Dictionary:
				_data = d
	return _data

static func reload() -> void:
	_data = null

static func _role_of_suffix(suffix: String, who: String = "") -> String:
	for r in ROLE_RULES:
		if r.size() > 2 and r[2] != who:
			continue
		if suffix.begins_with(r[0]):
			return r[1]
	return ""

## Enum range markers (ControlStart = Wait, DamageEnd = last damage status, ...) alias real statuses;
## per value the first name that is not a marker wins.
static func _build_roles(fkind: int) -> Dictionary:
	var out := {}
	var consts: Dictionary = (SSBDefs as Script).get_script_constant_map()
	var who: String = FT_NAMES[fkind] if fkind >= 0 and fkind < FT_NAMES.size() else ""
	var special_start := int(consts.get("nFTCommonStatusSpecialStart", 0x7FFFFFFF))
	for prefix in ["nFTCommonStatus", "nFT%sStatus" % who]:
		if prefix == "nFTStatus":
			continue
		var by_value := {}
		for nm in consts:
			var n: String = nm
			if not n.begins_with(prefix) or not (consts[nm] is int):
				continue
			var v := int(consts[nm])
			if prefix != "nFTCommonStatus" and v < special_start:
				continue
			if not by_value.has(v):
				by_value[v] = []
			by_value[v].append(n.substr(prefix.length()))
		for v in by_value:
			var names: Array = by_value[v]
			var pick: String = names[0]
			if names.size() > 1:
				for s in names:
					if not (s.ends_with("Start") or s.ends_with("End") or s.ends_with("Max") or s.ends_with("Count")):
						pick = s
						break
			var role := _role_of_suffix(pick, who if prefix != "nFTCommonStatus" else "")
			out[v] = [role if role != "" else "other", prefix + pick]
	return out

## [role, status constant name] for a status of this fighter kind.
static func role_info(fkind: int, status_id: int) -> Array:
	if not _roles.has(fkind):
		_roles[fkind] = _build_roles(fkind)
	return _roles[fkind].get(status_id, ["other", "status %d" % status_id])

static func role_for(fkind: int, status_id: int) -> String:
	return role_info(fkind, status_id)[0]

## Clip spec for a wrestler and role ({} when no recovered SvR clip covers it).
static func spec_for(slug: String, role: String) -> Dictionary:
	var d := data()
	var w = d.get("wrestlers", {}).get(slug, {})
	var s = w.get(role, null) if w is Dictionary else null
	if s == null:
		s = d.get("common", {}).get(role, null)
	if not (s is Dictionary) or not s.has("clip"):
		return {}
	var out: Dictionary = (s as Dictionary).duplicate()
	if not out.has("timing"):
		out.timing = "hit" if role in ATTACK_ROLES else ROLE_TIMING.get(role, "fit")
	return out

## Every clip key this wrestler can use (own roles, victim sides, common roles), for preloading.
static func clips_for(slug: String) -> Array:
	var keys := {}
	var d := data()
	for src in [d.get("wrestlers", {}).get(slug, {}), d.get("common", {})]:
		if not (src is Dictionary):
			continue
		for role in src:
			var s = src[role]
			if s is Dictionary:
				for k in ["clip", "victim_clip"]:
					if s.has(k):
						keys[str(s[k])] = true
				if s.has("by_status") and s.by_status is Dictionary:
					for st in s.by_status:
						var o = s.by_status[st]
						if o is Dictionary and o.has("clip"):
							keys[str(o.clip)] = true
	# victim sides of other wrestlers' throws (this wrestler can be thrown by anyone)
	for w in d.get("wrestlers", {}).values():
		if w is Dictionary:
			for role in ["throw_f", "throw_b"]:
				var s2 = w.get(role, null)
				if s2 is Dictionary and s2.has("victim_clip"):
					keys[str(s2.victim_clip)] = true
	return keys.keys()

